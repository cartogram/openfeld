---
import Base from "../../layouts/Base.astro";
import { getTranslations } from "../../i18n";

const locale = Astro.currentLocale ?? "de";
const t = getTranslations(locale);
---

<Base
  title={t.title}
  locale={locale}
  description={t.descriptionHome}
  url="/de/"
  alternateLocale="en"
  alternateUrl="/"
>
</Base>
