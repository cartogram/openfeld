---
import Base from "../layouts/Base.astro";
import { getTranslations } from "../i18n";

const locale = Astro.currentLocale ?? "en";
const t = getTranslations(locale);
---

<Base
  title={t.title}
  locale={locale}
  description={t.descriptionHome}
  url="/"
  alternateLocale="de"
  alternateUrl="/de/"
/>

