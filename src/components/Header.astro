---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Translations } from "../i18n";
import LanguageToggle from "./LanguageToggle.astro";

interface Props {
  t: Translations;
  locale: string;
}

const { t, locale } = Astro.props;
const detailsHref = `${getRelativeLocaleUrl(locale, "/")}#details`;
---

<header class="Header">
  <nav class='Header__link"'>
    <a href={detailsHref} class="Action">
      {t.info}
    </a>
  </nav>
  <nav class="Header__controls" aria-label="Language">
    <LanguageToggle />
  </nav>
</header>
