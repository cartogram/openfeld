---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Translations } from "../i18n";
import LanguageToggle from "./LanguageToggle.astro";

interface Props {
  t: Translations;
  locale: string;
}

const { t, locale } = Astro.props;
const detailsHref = `${getRelativeLocaleUrl(locale, "/")}#details`;
---

<header class="Header">
  <div class="layout-cols">
    <div class="layout-gutter" aria-hidden="true"></div>
    <div class="layout-span-main">
      <div class="layout-inner-cols header__inner">
        <div aria-hidden="true"></div>
        <a href={detailsHref} class="header__link">
          {t.info}
        </a>
        <nav class="header__controls" aria-label="Language">
          <LanguageToggle />
        </nav>
      </div>
    </div>
    <div class="layout-gutter" aria-hidden="true"></div>
  </div>
</header>
