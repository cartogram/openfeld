---
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale ?? "en";
const otherLocale = locale === "en" ? "de" : "en";
const currentCode = locale.toUpperCase();
const otherCode = otherLocale.toUpperCase();

const pathname = Astro.url.pathname;
const pathWithoutLocale = pathname.replace(/^\/(de|en)\//, "/");
const href = getRelativeLocaleUrl(otherLocale, pathWithoutLocale);

// Render in fixed "DE / EN" order regardless of current locale.
const first = locale === "de" ? "current" : "other";
---

<span class="lang-group">
  {
    first === "current" ? (
      <>
        <span class="lang-current" aria-current="true">{currentCode}</span>
        <span class="lang-sep" aria-hidden="true">/</span>
        <a class="lang-toggle" href={href} data-other-locale={otherLocale}>
          {otherCode}
        </a>
      </>
    ) : (
      <>
        <a class="lang-toggle" href={href} data-other-locale={otherLocale}>
          {otherCode}
        </a>
        <span class="lang-sep" aria-hidden="true">/</span>
        <span class="lang-current" aria-current="true">{currentCode}</span>
      </>
    )
  }
</span>

<script>
  const toggle = document.querySelector(".lang-toggle") as HTMLAnchorElement;
  const otherLocale = toggle.dataset.otherLocale!;

  toggle.addEventListener("click", () => {
    localStorage.setItem("preferred-locale", otherLocale);
  });

  // Redirect to preferred locale on first visit
  const preferred = localStorage.getItem("preferred-locale");
  const current = document.documentElement.lang;
  if (preferred && preferred !== current) {
    const path = window.location.pathname.replace(/^\/(de|en)\//, "/");
    const target = preferred === "en" ? path : `/${preferred}${path}`;
    window.location.replace(target);
  }
</script>
