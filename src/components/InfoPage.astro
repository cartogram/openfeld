---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Translations } from "../i18n";
import { HOURS, MONTH_NAMES } from "../data/hours";

interface Props {
  t: Translations;
  locale: string;
}

const { t, locale } = Astro.props;
const homeHref = getRelativeLocaleUrl(locale, "/");
---

<div class="overlay" transition:animate="fade">
  <div class="page">
    <header class="info-header">
      <a href={homeHref} class="back-link">{t.close}</a>
    </header>

    <section>
      <h2>{t.openingHours}</h2>
      <table>
        <thead>
          <tr>
            <th class="heading--3">{t.monthHeader}</th>
            <th class="heading--3">{t.openHeader}</th>
            <th class="heading--3">{t.closeHeader}</th>
          </tr>
        </thead>
        <tbody>
          {
            Object.entries(HOURS).map(([month, entry]) => (
              <tr>
                <td>{MONTH_NAMES[Number(month)]}</td>
                <td>{entry.open}</td>
                <td>
                  {entry.close}
                  {entry.splitDay && (
                    <span class="note heading--3">
                      ({entry.lateClose && <span>{entry.lateClose}</span>}
                      {t.from} {MONTH_NAMES[Number(month)]} {entry.splitDay})
                    </span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section>
      <h2>{t.about}</h2>
      <p>{t.aboutText}</p>
    </section>

    <section>
      <ul>
        <li>
          <a
            href="https://mattseccafien.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            mattseccafien.com
          </a>
        </li>
        <li>
          <a
            href="https://www.tempelhofer-feld.berlin.de"
            target="_blank"
            rel="noopener noreferrer"
          >
            tempelhofer-feld.berlin.de
          </a>
          — {t.officialSite}
        </li>
        <li>
          <a
            href="https://www.thf100.de"
            target="_blank"
            rel="noopener noreferrer"
          >
            100% Tempelhofer Feld
          </a>
          — {t.thf100Desc}
        </li>
      </ul>
    </section>
  </div>
</div>

<style>
  .overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    overflow: scroll;
    min-height: 100dvh;
    background-color: var(--main-background-color);
  }

  .page {
    box-sizing: border-box;
    max-width: 52ch;
    width: 100%;
    margin-inline: auto;
    padding-block-end: var(--spacing-1);
    padding-block-start: max(var(--spacing-1), var(--site-header-offset));
    padding-inline: var(--layout-gutter);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }
</style>
