---
import type { Translations } from "../i18n";

interface Props {
  t: Translations;
  locale: string;
}

const { t, locale } = Astro.props;
---

<div
  id="interface"
  class="interface layout-cols"
  data-t-open={t.open}
  data-t-closed={t.closed}
  data-t-opens-in={t.opensIn}
  data-t-closes-in={t.closesIn}
  data-locale={locale}
  transition:name={`interface-${locale}`}
>
  <div class="layout-gutter" aria-hidden="true"></div>
  <div class="layout-span-main interface__main">
    <div class="layout-inner-cols interface__top">
      <h1 class="interface__title">{t.title}</h1>
      <p class="interface__countdown">
        <span id="countdown-label" class="interface__countdown-label"></span>
        <time id="countdown" datetime="" class="interface__countdown-time">
          <span class="interface__countdown-row">
            <span id="countdown-hours">0</span>
            <span class="interface__countdown-unit">{t.hours}</span>
          </span>
          <span class="interface__countdown-row">
            <span id="countdown-minutes">0</span>
            <span class="interface__countdown-unit">{t.minutes}</span>
          </span>
          <span class="interface__countdown-row">
            <span id="countdown-seconds">0</span>
            <span class="interface__countdown-unit">{t.seconds}</span>
          </span>
        </time>
      </p>
    </div>
    <span id="status" class="interface__status display" role="status" aria-live="polite">
      {t.loading}
    </span>
  </div>
  <div class="layout-gutter" aria-hidden="true"></div>
</div>

<script>
  import { isOpen, getTargetTime as getTarget } from "../data/hours.js";

  let intervalId: ReturnType<typeof setInterval> | undefined;
  let lastFaviconStatus: boolean | null = null;

  function formatDuration(ms: number): {
    h: number;
    m: number;
    s: number;
    iso: string;
  } {
    const totalSeconds = Math.max(0, Math.floor(ms / 1000));
    const h = Math.floor(totalSeconds / 3600);
    const m = Math.floor((totalSeconds % 3600) / 60);
    const s = totalSeconds % 60;
    const iso = `PT${h}H${m}M${s}S`;
    return { h, m, s, iso };
  }

  function updateFavicon(open: boolean) {
    if (lastFaviconStatus === open) return;
    lastFaviconStatus = open;

    const canvas = document.createElement("canvas");
    canvas.width = 32;
    canvas.height = 32;
    const ctx = canvas.getContext("2d")!;
    ctx.beginPath();
    ctx.arc(16, 16, 14, 0, Math.PI * 2);
    ctx.fillStyle = open ? "#22c55e" : "#ef4444";
    ctx.fill();

    const href = canvas.toDataURL("image/png");
    let link = document.querySelector('link[rel="icon"]') as HTMLLinkElement;

    if (!link) {
      link = document.createElement("link");
      link.rel = "icon";
      document.head.appendChild(link);
    }
    link.type = "image/png";
    link.href = href;
  }

  function init() {
    lastFaviconStatus = null;
    const el = document.getElementById("interface");
    if (!el) return;

    const statusEl = document.getElementById("status")!;
    const countdownLabel = document.getElementById("countdown-label")!;
    const countdownEl = document.getElementById("countdown") as HTMLTimeElement;
    const hoursEl = document.getElementById("countdown-hours")!;
    const minutesEl = document.getElementById("countdown-minutes")!;
    const secondsEl = document.getElementById("countdown-seconds")!;

    const tOpen = el.dataset.tOpen!;
    const tClosed = el.dataset.tClosed!;
    const tOpensIn = el.dataset.tOpensIn!;
    const tClosesIn = el.dataset.tClosesIn!;

    function update() {
      const now = new Date();
      const open = isOpen(now);
      const status = open ? "open" : "closed";

      document.documentElement.setAttribute("data-status", status);
      statusEl.textContent = open ? tOpen : tClosed;

      const { target } = getTarget(now, open);
      const remaining = target.getTime() - now.getTime();
      const { h, m, s, iso } = formatDuration(remaining);

      const label = open ? tClosesIn : tOpensIn;
      countdownLabel.textContent = label;
      hoursEl.textContent = String(h);
      minutesEl.textContent = String(m).padStart(2, "0");
      secondsEl.textContent = String(s).padStart(2, "0");
      countdownEl.setAttribute("datetime", iso);

      const display = `${h}h ${String(m).padStart(2, "0")}m ${String(s).padStart(2, "0")}s`;
      document.title = `${label} ${display} — Tempelhof Feld`;
      updateFavicon(open);
    }

    if (intervalId) clearInterval(intervalId);
    update();
    intervalId = setInterval(update, 1_000);
  }

  document.addEventListener("astro:page-load", init);
</script>

<style>
  .interface {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    min-height: 0;
    min-width: 0;
    height: 100dvh;
    padding-block: var(--site-header-offset);
    pointer-events: none;
  }

  .interface__main {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    min-height: 0;
  }

  .interface__top {
    align-items: start;
    padding-block-start: var(--site-header-offset);
  }

  .interface__title {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-light);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    line-height: 1.4;
    width: min-content;
    padding: 0;
    margin: 0;
    grid-column: 1;
  }

  .interface__countdown {
    grid-column: 2;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-light);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    line-height: 1.4;
  }

  .interface__countdown-label {
    display: none;
  }

  .interface__countdown-time {
    display: grid;
    width: min-content;
    grid-template-columns: max-content max-content;
    column-gap: 0.5em;
    row-gap: 0;
  }

  .interface__countdown-row {
    display: contents;
  }

  .interface__countdown-unit {
    white-space: nowrap;
  }

  .interface__status {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-size: clamp(6rem, 22vw, 22rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.02em;
    align-self: end;
  }
</style>
